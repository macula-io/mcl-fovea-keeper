# The keeper, one run: a user unit on the keeper's machine. It runs the keeper
# image BY DIGEST (KEEPER_IMAGE, set in the machine's keeper.env, never here) on
# the podman network fovea-keeper: an IPv6 route to the IPv6-only stations and
# none to the machine's localhost-only services. Nothing from the records
# repository is executed: the image brings the code, the machine the config.
# A failed run fails the unit, so `systemctl --user --failed` and the journal
# show it.
[Unit]
Description=fovea keeper: keep fovea's signed observations (mcl-fovea-records)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# KEEPER_IMAGE=ghcr.io/macula-io/mcl-fovea-keeper@sha256:<digest>
EnvironmentFile=%h/fovea-keeper/keeper.env
# Extra podman run arguments for this machine (e.g. --cgroup-parent), from a drop-in.
Environment=KEEPER_PODMAN_ARGS=
ExecStart=/usr/bin/podman run --rm --pull=missing --network fovea-keeper $KEEPER_PODMAN_ARGS \
    -v %h/fovea-keeper/mcl-fovea-records:/records \
    -v %h/fovea-keeper/keeper.json:/etc/fovea-keeper/keeper.json:ro \
    -v %h/.ssh/fovea_keeper_deploy:/etc/fovea-keeper/deploy_key:ro \
    -v %h/fovea-keeper/known_hosts:/etc/fovea-keeper/known_hosts:ro \
    ${KEEPER_IMAGE}
CPUQuota=200%
MemoryMax=4G
TimeoutStartSec=12min
